#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Default to LF for text files
*               text=auto eol=lf

# Binary files: no diff, no newline conversion
*.jar           binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary

# Lock files: exclude from diff and language stats
frontend/package-lock.json  -diff linguist-generated=true
frontend/pnpm-lock.yaml     -diff linguist-generated=true

